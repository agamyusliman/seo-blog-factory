# Copy to .env and fill values. Never commit .env.

# OpenAI-compatible gateway (chat + image via /v1/responses)
AI_BASE_URL=https://your-gateway.example/v1
AI_API_KEY=replace-with-your-api-key
# Chat: multi-model round-robin (comma-separated). Falls back across models on error.
# Example: glm-5.2 (1M+ context) primary, grok-4.5 fallback.
AI_CHAT_MODELS=glm-5.2,grok-4.5
# Legacy single-model alias (used only if AI_CHAT_MODELS is empty)
AI_CHAT_MODEL=grok-4.5
# Image: single model (grok-4.5 supports image_generation tool)
AI_IMAGE_MODEL=grok-4.5

# Article limits
BLOG_DAILY_CAP=30
BLOG_MIN_WORDS=500
BLOG_MAX_WORDS=2000
BLOG_DEFAULT_INLINE_IMAGES=3

# Project root (usually leave as .)
BLOG_ROOT=.
